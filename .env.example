# Copy this file to .env and fill it in. Never commit .env.
# Needed for the live dashboard (npm run dashboard) and for npm run eval / make-demo.
TYPESAFE_API_KEY=

# Optional
# GITHUB_TOKEN=          # raises GitHub API rate limits for public repositories
# GITHUB_CLIENT_ID=      # enables "Sign in with GitHub" (OAuth App with Device Flow)
# PORT=4173
# AUTO=0                 # disable the automatic watcher
# JEV_MODEL=jev-latest
